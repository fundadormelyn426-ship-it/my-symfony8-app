{% extends 'base.html.twig' %}

{% block title %}Order Successful — Fundador Coffee Shop{% endblock %}

{% block body %}
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#f7efe5;padding:20px;">
    <div style="background:#fff;padding:50px 40px;border-radius:16px;box-shadow:0 10px 40px rgba(0,0,0,0.08);width:100%;max-width:480px;text-align:center;">

        <div style="font-size:60px;color:#28551e;margin-bottom:16px;">✓</div>

        <h1 style="font-family:'Playfair Display',serif;font-size:32px;color:#281105;margin:0 0 12px;">
            Order Successful!
        </h1>

        <p style="color:#7a6a5d;font-size:14px;margin-bottom:8px;">
            Your order has been received.
        </p>

        <p style="color:#281105;font-size:18px;font-weight:600;margin:16px 0 24px;">
            Total: <span style="color:#28551e;">₱0.00</span>
        </p>

        <a href="{{ path('home') }}#menu" style="display:inline-block;padding:12px 28px;background:#28551e;color:#fff;text-decoration:none;border-radius:8px;font-size:14px;font-weight:600;">
            Back to Shop
        </a>

        <div style="margin-top:20px;">
            <a href="#" style="color:#7a6a5d;font-size:13px;text-decoration:none;">
                View Receipt →
            </a>
        </div>

    </div>
</div>
{% endblock %}