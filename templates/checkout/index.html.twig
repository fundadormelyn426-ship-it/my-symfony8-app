{% extends 'base.html.twig' %}

{% block title %}Checkout - Fundador Coffee Shop{% endblock %}

{% block body %}

<header class="header">
    <div class="nav">
        <a class="logo" href="{{ path('home') }}">
            <span class="cup">☕</span>
            <span>
                <b>FUNDADOR</b>
                <small>COFFEE SHOP</small>
            </span>
        </a>
        <nav>
            <a href="{{ path('home') }}">Shop</a>
            <a href="{{ path('app_cart') }}">Cart</a>
            <a href="{{ path('app_checkout') }}" class="active">Checkout</a>
        </nav>
    </div>
</header>

<main style="padding:28px;width:min(1100px,94%);margin:auto;">
    <h1 style="font:700 32px 'Playfair Display',serif;color:#2b1206;">Checkout</h1>

    {% if error %}
        <div style="background:#f9e6e6;padding:12px;border-radius:8px;margin-bottom:16px;color:#8b1a1a;">
            ✗ {{ error }}
        </div>
    {% endif %}

    <div style="display:grid;grid-template-columns:1fr 380px;gap:24px;margin-top:20px;">

        <!-- LEFT: Checkout Form -->
        <div style="background:#fffaf3;padding:24px;border-radius:12px;">
            <h2 style="font:600 20px 'Playfair Display',serif;color:#2b1206;margin-top:0;">Your Details</h2>

            <form method="post" style="display:grid;gap:14px;">

                <div>
                    <label style="display:block;font-size:13px;margin-bottom:5px;color:#7a6350;">Full Name *</label>
                    <input type="text" name="name" required value="{{ app.user ? app.user.name : '' }}" style="width:100%;padding:11px;border:1px solid #d8c5b2;border-radius:7px;">
                </div>

                <div>
                    <label style="display:block;font-size:13px;margin-bottom:5px;color:#7a6350;">Email *</label>
                    <input type="email" name="email" required value="{{ app.user ? app.user.email : '' }}" style="width:100%;padding:11px;border:1px solid #d8c5b2;border-radius:7px;">
                </div>

                <div>
                    <label style="display:block;font-size:13px;margin-bottom:5px;color:#7a6350;">Payment Method *</label>
                    <div style="display:grid;gap:8px;">
                        <label style="display:flex;align-items:center;gap:10px;padding:10px;border:1px solid #d8c5b2;border-radius:7px;cursor:pointer;">
                            <input type="radio" name="payment_method" value="Cash" checked onchange="toggleGcash()">
                            <span>💵 Cash on Pickup</span>
                        </label>
                        <label style="display:flex;align-items:center;gap:10px;padding:10px;border:1px solid #d8c5b2;border-radius:7px;cursor:pointer;">
                            <input type="radio" name="payment_method" value="GCash" onchange="toggleGcash()">
                            <span>📱 GCash</span>
                        </label>
                    </div>
                </div>

                <div id="gcashBox" style="display:none;">
                    <label style="display:block;font-size:13px;margin-bottom:5px;color:#7a6350;">GCash Reference Number *</label>
                    <input type="text" name="gcash_reference" placeholder="e.g., 1234567890" maxlength="100" style="width:100%;padding:11px;border:1px solid #d8c5b2;border-radius:7px;">
                    <small style="color:#9a826b;font-size:11px;">Send payment to: 0912-345-6789 (Fundador Coffee)</small>
                </div>

                <button type="submit" style="background:#28551e;color:#fff;border:0;padding:13px 24px;border-radius:7px;cursor:pointer;font-weight:600;font-size:15px;margin-top:8px;">
                    Place Order →
                </button>
            </form>
        </div>

        <!-- RIGHT: Order Summary -->
        <div style="background:#fffaf3;padding:24px;border-radius:12px;height:fit-content;">
            <h2 style="font:600 20px 'Playfair Display',serif;color:#2b1206;margin-top:0;">Order Summary</h2>

            {% for item in cart %}
            <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #eadccc;">
                <div>
                    <b style="color:#2b1206;">{{ item.name }}</b>
                    <br><small style="color:#7a6350;">× {{ item.quantity }}</small>
                </div>
                <div style="font-weight:600;color:#2b1206;">₱{{ (item.price * item.quantity)|number_format(2) }}</div>
            </div>
            {% endfor %}

            <div style="display:flex;justify-content:space-between;padding:16px 0;font-size:20px;font-weight:700;color:#28551e;">
                <span>Total</span>
                <span>₱{{ total|number_format(2) }}</span>
            </div>

            <a href="{{ path('app_cart') }}" style="display:block;text-align:center;color:#7a6350;text-decoration:none;font-size:13px;margin-top:8px;">← Back to Cart</a>
        </div>

    </div>
</main>

<script>
function toggleGcash() {
    const gcash = document.querySelector('input[name="payment_method"][value="GCash"]').checked;
    document.getElementById('gcashBox').style.display = gcash ? 'block' : 'none';
}
</script>

{% endblock %}