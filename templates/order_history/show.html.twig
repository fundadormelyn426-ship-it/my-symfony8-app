{% extends 'base.html.twig' %}

{% block title %}Order #{{ order.id }} - Fundador Coffee Shop{% endblock %}

{% block body %}

<header class="header">
    <div class="nav">
        <a class="logo" href="{{ path('home') }}">
            <span class="cup">☕</span>
            <span>
                <b>FUNDADOR</b>
                <small>COFFEE SHOP</small>
            </span>
        </a>
        <nav>
            <a href="{{ path('home') }}">Shop</a>
            <a href="{{ path('app_cart') }}">Cart</a>
            <a href="{{ path('app_my_orders') }}" class="active">My Orders</a>
            {% if app.user %}
                <a href="{{ path('app_logout') }}">Logout</a>
            {% endif %}
        </nav>
    </div>
</header>

<main style="padding:28px;width:min(900px,94%);margin:auto;">
    <a href="{{ path('app_my_orders') }}" style="color:#7a6350;text-decoration:none;font-size:13px;">← Back to My Orders</a>

    <h1 style="font:700 32px 'Playfair Display',serif;color:#2b1206;margin-top:14px;">Order #{{ order.id }}</h1>

    <div style="background:#fffaf3;padding:24px;border-radius:12px;margin-top:20px;">
        <p><b>Date:</b> {{ order.createdAt ? order.createdAt|date('M d, Y H:i') : '—' }}</p>
        <p><b>Status:</b> <span style="font-weight:700;
            {% if order.status == 'Completed' %}color:#28551e;
            {% elseif order.status == 'Cancelled' %}color:#a13b27;
            {% elseif order.status == 'Pending' %}color:#c9863b;
            {% else %}color:#2c6eb5;{% endif %}">{{ order.status }}</span></p>
        <p><b>Payment Method:</b> {{ order.paymentMethod ?? '—' }}</p>
        {% if order.gcashReference %}
            <p><b>GCash Reference:</b> {{ order.gcashReference }}</p>
        {% endif %}
    </div>

    <div style="background:#fffaf3;padding:24px;border-radius:12px;margin-top:20px;">
        <h2 style="font:600 20px 'Playfair Display',serif;color:#2b1206;margin-top:0;">Items</h2>
        <table style="width:100%;border-collapse:collapse;">
            <thead>
                <tr style="border-bottom:1px solid #eadccc;">
                    <th style="padding:10px;text-align:left;">Product</th>
                    <th style="padding:10px;text-align:right;">Price</th>
                    <th style="padding:10px;text-align:center;">Qty</th>
                    <th style="padding:10px;text-align:right;">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                {% for item in order.orderItems %}
                <tr style="border-bottom:1px solid #f0e4d6;">
                    <td style="padding:12px;">{{ item.productName }}</td>
                    <td style="padding:12px;text-align:right;">₱{{ item.price|number_format(2) }}</td>
                    <td style="padding:12px;text-align:center;">{{ item.quantity }}</td>
                    <td style="padding:12px;text-align:right;font-weight:700;">₱{{ item.subtotal|number_format(2) }}</td>
                </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" style="padding:16px;text-align:right;font-weight:700;">Total:</td>
                    <td style="padding:16px;text-align:right;font-weight:700;color:#28551e;font-size:20px;">₱{{ order.total|number_format(2) }}</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div style="margin-top:20px;text-align:center;">
        <a href="{{ path('home') }}" style="background:#28551e;color:#fff;padding:11px 24px;border-radius:7px;text-decoration:none;font-weight:600;">Order Again</a>
    </div>
</main>

{% endblock %}