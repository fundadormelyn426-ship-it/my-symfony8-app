<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Receipt #{{ order.id }} - Fundador Coffee Shop</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Courier New', monospace;
            background: #f7efe5;
            margin: 0;
            padding: 20px;
            color: #2b1206;
        }
        .receipt {
            max-width: 400px;
            margin: 0 auto;
            background: #fff;
            padding: 30px 24px;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }
        .header {
            text-align: center;
            border-bottom: 2px dashed #7a6350;
            padding-bottom: 16px;
            margin-bottom: 16px;
        }
        .header h1 {
            font-family: Georgia, serif;
            font-size: 22px;
            margin: 0;
            letter-spacing: 2px;
        }
        .header p {
            margin: 4px 0 0;
            font-size: 11px;
            letter-spacing: 1px;
        }
        .header .cup { font-size: 32px; display: block; margin-bottom: 6px; }
        .order-info {
            font-size: 12px;
            margin-bottom: 16px;
            border-bottom: 1px dashed #7a6350;
            padding-bottom: 12px;
        }
        .order-info p { margin: 3px 0; display: flex; justify-content: space-between; }
        .items { margin: 16px 0; }
        .item {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            margin: 6px 0;
        }
        .item-name { flex: 1; }
        .item-qty { width: 40px; text-align: center; }
        .item-price { width: 80px; text-align: right; }
        .total {
            border-top: 2px dashed #7a6350;
            padding-top: 12px;
            margin-top: 12px;
            display: flex;
            justify-content: space-between;
            font-size: 16px;
            font-weight: bold;
        }
        .footer {
            text-align: center;
            margin-top: 24px;
            padding-top: 16px;
            border-top: 1px dashed #7a6350;
            font-size: 11px;
            color: #7a6350;
        }
        .footer .thanks { font-size: 14px; color: #2b1206; margin-bottom: 6px; }
        .actions {
            text-align: center;
            margin-top: 20px;
        }
        .btn {
            display: inline-block;
            background: #28551e;
            color: #fff;
            padding: 10px 20px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 13px;
            font-family: Arial, sans-serif;
            margin: 0 4px;
            cursor: pointer;
            border: 0;
        }
        .btn-outline {
            background: none;
            border: 1px solid #28551e;
            color: #28551e;
        }
        @media print {
            body { background: #fff; padding: 0; }
            .receipt { box-shadow: none; padding: 20px; }
            .actions { display: none; }
        }
    </style>
</head>
<body>

<div class="receipt">

    <div class="header">
        <span class="cup">☕</span>
        <h1>FUNDADOR</h1>
        <p>COFFEE SHOP</p>
        <p>— EST 2026 —</p>
    </div>

    <div class="order-info">
        <p><span>Order #:</span> <strong>#{{ order.id }}</strong></p>
        <p><span>Date:</span> <span>{{ order.createdAt ? order.createdAt|date('M d, Y H:i') : '—' }}</span></p>
        <p><span>Customer:</span> <span>{{ order.user ? order.user.name : 'Guest' }}</span></p>
        <p><span>Email:</span> <span>{{ order.user ? order.user.email : '—' }}</span></p>
        <p><span>Payment:</span> <span>{{ order.paymentMethod ?? '—' }}</span></p>
        {% if order.gcashReference %}
            <p><span>GCash Ref:</span> <span>{{ order.gcashReference }}</span></p>
        {% endif %}
        <p><span>Status:</span> <strong>{{ order.status }}</strong></p>
    </div>

    <div class="items">
        <div class="item" style="font-weight:bold; border-bottom:1px solid #eadccc; padding-bottom:6px;">
            <span class="item-name">ITEM</span>
            <span class="item-qty">QTY</span>
            <span class="item-price">PRICE</span>
        </div>
        {% for item in order.orderItems %}
        <div class="item">
            <span class="item-name">{{ item.productName }}</span>
            <span class="item-qty">{{ item.quantity }}</span>
            <span class="item-price">₱{{ item.subtotal|number_format(2) }}</span>
        </div>
        {% endfor %}
    </div>

    <div class="total">
        <span>TOTAL</span>
        <span>₱{{ order.total|number_format(2) }}</span>
    </div>

    <div class="footer">
        <p class="thanks">Thank you! ☕</p>
        <p>Daro, Dumaguete City</p>
        <p>+63 912 345 6789</p>
        <p>hello@fundadorcoffeeshop.com</p>
        <p style="margin-top:8px;">© 2026 Fundador Coffee Shop</p>
    </div>

</div>

<div class="actions">
    <button class="btn" onclick="window.print()">🖨️ Print</button>
    <a href="{{ path('app_my_orders') }}" class="btn btn-outline">← Back to Orders</a>
</div>

</body>
</html>