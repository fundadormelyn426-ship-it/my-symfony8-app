{% extends 'base.html.twig' %}

{% block title %}Order Confirmed - Fundador Coffee Shop{% endblock %}

{% block body %}

<header class="header">
    <div class="nav">
        <a class="logo" href="{{ path('home') }}">
            <span class="cup">☕</span>
            <span>
                <b>FUNDADOR</b>
                <small>COFFEE SHOP</small>
            </span>
        </a>
        <nav>
            <a href="{{ path('home') }}">Shop</a>
            {% if app.user %}
                <a href="{{ path('dashboard') }}">Dashboard</a>
                <a href="{{ path('app_logout') }}">Logout</a>
            {% else %}
                <a href="{{ path('app_login') }}">Login</a>
            {% endif %}
        </nav>
    </div>
</header>

<main style="padding:28px;width:min(700px,94%);margin:auto;text-align:center;">
    
    <div style="background:#eaf3e7;width:100px;height:100px;border-radius:50%;display:grid;place-items:center;margin:40px auto 20px;">
        <span style="font-size:50px;">✅</span>
    </div>

    <h1 style="font:700 32px 'Playfair Display',serif;color:#28551e;margin:0;">Order Confirmed!</h1>
    <p style="color:#7a6350;margin:8px 0 24px;">Thank you for your order. We'll prepare it right away.</p>

    <div style="background:#fffaf3;padding:24px;border-radius:12px;text-align:left;">
        <div style="display:flex;justify-content:space-between;border-bottom:1px solid #eadccc;padding-bottom:12px;margin-bottom:12px;">
            <b style="color:#2b1206;">Order #{{ order.id }}</b>
            <span style="color:#c9863b;font-weight:700;">{{ order.status }}</span>
        </div>
        
        <table style="width:100%;border-collapse:collapse;">
            <tr>
                <td style="padding:8px 0;color:#7a6350;font-size:13px;">Date</td>
                <td style="padding:8px 0;text-align:right;">{{ order.createdAt|date('M d, Y H:i') }}</td>
            </tr>
            <tr>
                <td style="padding:8px 0;color:#7a6350;font-size:13px;">Payment Method</td>
                <td style="padding:8px 0;text-align:right;">{{ order.paymentMethod }}</td>
            </tr>
            <tr>
                <td style="padding:8px 0;color:#7a6350;font-size:13px;">Customer</td>
                <td style="padding:8px 0;text-align:right;">{{ order.user ? order.user.name : 'Guest' }}</td>
            </tr>
        </table>
        
        <div style="border-top:1px solid #eadccc;margin-top:12px;padding-top:12px;">
            <h3 style="font:600 15px 'Playfair Display',serif;margin:0 0 10px;">Items Ordered</h3>
            <table style="width:100%;border-collapse:collapse;">
                {% for item in order.orderItems %}
                <tr style="border-bottom:1px solid #f0e4d6;">
                    <td style="padding:8px 0;">
                        {{ item.productName }}<br>
                        <small style="color:#7a6350;">×{{ item.quantity }}</small>
                    </td>
                    <td style="padding:8px 0;text-align:right;">₱{{ item.subtotal|number_format(2) }}</td>
                </tr>
                {% endfor %}
                <tr>
                    <td style="padding:14px 0 0;font-weight:700;">Total</td>
                    <td style="padding:14px 0 0;text-align:right;font-weight:700;color:#28551e;font-size:18px;">
                        ₱{{ order.total|number_format(2) }}
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <div style="margin-top:24px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <a href="{{ path('home') }}" style="background:#28551e;color:#fff;padding:11px 24px;border-radius:7px;text-decoration:none;font-weight:600;">Continue Shopping</a>
        {% if app.user %}
            <a href="{{ path('dashboard') }}" style="background:#e8d8c8;color:#2b1206;padding:11px 24px;border-radius:7px;text-decoration:none;font-weight:600;">View My Orders</a>
        {% endif %}
    </div>
</main>

{% endblock %}