{% extends 'base.html.twig' %}

{% block title %}Checkout - Fundador Coffee Shop{% endblock %}

{% block body %}

<header class="header">
    <div class="nav">
        <a class="logo" href="{{ path('home') }}">
            <span class="cup">☕</span>
            <span>
                <b>FUNDADOR</b>
                <small>COFFEE SHOP</small>
            </span>
        </a>
        <nav>
            <a href="{{ path('home') }}">Shop</a>
            <a href="{{ path('app_cart') }}">Cart</a>
        </nav>
    </div>
</header>

<main style="padding:28px;width:min(1000px,94%);margin:auto;">
    <h1 style="font:700 32px 'Playfair Display',serif;color:#2b1206;">Checkout</h1>
    <p style="color:#7a6350;margin-top:4px;">Complete your order details below.</p>

    <div style="display:grid;grid-template-columns:1.5fr 1fr;gap:24px;margin-top:24px;">
        
        <!-- Checkout Form -->
        <div style="background:#fffaf3;padding:24px;border-radius:12px;">
            <h2 style="font:600 20px 'Playfair Display',serif;color:#2b1206;margin-top:0;">Order Details</h2>
            
            <form method="post" style="display:grid;gap:16px;">
                
                <div>
                    <label style="display:block;font-size:13px;margin-bottom:6px;color:#7a6350;font-weight:600;">Full Name *</label>
                    <input type="text" name="customer_name" required 
                           value="{{ app.user ? app.user.name : '' }}"
                           style="width:100%;padding:11px;border:1px solid #d8c5b2;border-radius:7px;box-sizing:border-box;">
                </div>

                <div>
                    <label style="display:block;font-size:13px;margin-bottom:6px;color:#7a6350;font-weight:600;">Email *</label>
                    <input type="email" name="customer_email" required 
                           value="{{ app.user ? app.user.email : '' }}"
                           style="width:100%;padding:11px;border:1px solid #d8c5b2;border-radius:7px;box-sizing:border-box;">
                </div>

                <div>
                    <label style="display:block;font-size:13px;margin-bottom:6px;color:#7a6350;font-weight:600;">Payment Method *</label>
                    <div style="display:grid;gap:10px;">
                        <label style="display:flex;align-items:center;gap:10px;padding:12px;border:2px solid #d8c5b2;border-radius:7px;cursor:pointer;">
                            <input type="radio" name="payment_method" value="Cash" checked>
                            <span>💵 Cash on Pickup</span>
                        </label>
                        <label style="display:flex;align-items:center;gap:10px;padding:12px;border:2px solid #d8c5b2;border-radius:7px;cursor:pointer;">
                            <input type="radio" name="payment_method" value="GCash">
                            <span>📱 GCash</span>
                        </label>
                    </div>
                </div>

                <button type="submit" 
                        style="background:#28551e;color:#fff;border:0;padding:14px;border-radius:7px;font-weight:700;font-size:15px;cursor:pointer;margin-top:8px;">
                    Place Order — ₱{{ total|number_format(2) }}
                </button>

                <a href="{{ path('app_cart') }}" 
                   style="text-align:center;color:#7a6350;text-decoration:none;font-size:13px;">
                    ← Back to Cart
                </a>
            </form>
        </div>

        <!-- Order Summary -->
        <div style="background:#fffaf3;padding:24px;border-radius:12px;height:fit-content;">
            <h2 style="font:600 18px 'Playfair Display',serif;color:#2b1206;margin-top:0;">Order Summary</h2>
            
            <table style="width:100%;border-collapse:collapse;">
                {% for item in cart %}
                <tr style="border-bottom:1px solid #f0e4d6;">
                    <td style="padding:10px 0;">
                        <b style="color:#2b1206;">{{ item.name }}</b><br>
                        <small style="color:#7a6350;">×{{ item.quantity }}</small>
                    </td>
                    <td style="padding:10px 0;text-align:right;color:#2b1206;">
                        ₱{{ (item.price * item.quantity)|number_format(2) }}
                    </td>
                </tr>
                {% endfor %}
                <tr>
                    <td style="padding:14px 0 0;font-weight:700;">Total</td>
                    <td style="padding:14px 0 0;text-align:right;font-weight:700;color:#28551e;font-size:18px;">
                        ₱{{ total|number_format(2) }}
                    </td>
                </tr>
            </table>
        </div>

    </div>
</main>

<style>
    @media (max-width: 700px) {
        main > div { grid-template-columns: 1fr !important; }
    }
</style>

{% endblock %}