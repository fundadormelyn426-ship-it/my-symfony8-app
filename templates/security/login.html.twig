{% extends 'base.html.twig' %}

{% block title %}Login — Fundador Coffee Shop{% endblock %}

{% block body %}
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#f7efe5;padding:20px;">
    <div style="background:#fff;padding:40px;border-radius:16px;box-shadow:0 10px 40px rgba(0,0,0,0.08);width:100%;max-width:420px;">

        <div style="text-align:center;margin-bottom:30px;">
            <div style="font-size:48px;">☕</div>
            <h1 style="font-family:'Playfair Display',serif;font-size:28px;color:#281105;margin:10px 0;">Welcome Back</h1>
            <p style="color:#7a6a5d;font-size:14px;">Login to your Fundador account</p>
        </div>

        {% if error %}
            <div style="background:#fee2e2;color:#991b1b;padding:12px;border-radius:8px;margin-bottom:20px;font-size:14px;">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% for message in app.flashes('success') %}
            <div style="background:#dcfce7;color:#166534;padding:12px;border-radius:8px;margin-bottom:20px;font-size:14px;">
                {{ message }}
            </div>
        {% endfor %}

        <form method="post">
            <div style="margin-bottom:16px;">
                <label style="display:block;font-size:13px;color:#281105;font-weight:600;margin-bottom:6px;">Email</label>
                <input
                    type="email"
                    name="_username"
                    value="{{ last_username }}"
                    required
                    autofocus
                    placeholder="you@example.com"
                    style="width:100%;padding:12px;border:1px solid #d8c5b2;border-radius:8px;font-size:14px;box-sizing:border-box;"
                >
            </div>

            <div style="margin-bottom:24px;">
                <label style="display:block;font-size:13px;color:#281105;font-weight:600;margin-bottom:6px;">Password</label>
                <input
                    type="password"
                    name="_password"
                    required
                    placeholder="••••••••"
                    style="width:100%;padding:12px;border:1px solid #d8c5b2;border-radius:8px;font-size:14px;box-sizing:border-box;"
                >
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button
                type="submit"
                style="width:100%;padding:14px;background:#28551e;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;"
            >
                Login
            </button>
        </form>

        <div style="text-align:center;margin-top:24px;font-size:13px;color:#7a6a5d;">
            Don't have an account?
            <a href="{{ path('app_register') }}" style="color:#28551e;font-weight:600;text-decoration:none;">Register here</a>
        </div>

        <div style="text-align:center;margin-top:16px;">
            <a href="{{ path('home') }}" style="color:#7a6a5d;font-size:12px;text-decoration:none;">← Back to Home</a>
        </div>

    </div>
</div>
{% endblock %}